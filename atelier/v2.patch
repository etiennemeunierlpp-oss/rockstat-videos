 // ---------------------------------------------------------------- composition
+const shakeAt = (fr: number, shakes: number[]) => {
+  let x = 0, y = 0, r = 0;
+  for (const s of shakes) {
+    const d = fr - s;
+    if (d >= 0 && d < 10) {
+      const a = (1 - d / 10) * 26;
+      x += Math.sin(d * 2.7) * a; y += Math.cos(d * 3.1) * a * 0.6; r += Math.sin(d * 1.9) * a * 0.04;
+    }
+  }
+  return `translate(${x}px, ${y}px) rotate(${r}deg)`;
+};
+
